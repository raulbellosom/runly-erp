{
  "name": "runly-erp-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "check:privacy": "node scripts/check-repository-privacy.mjs",
    "check:company-scope": "node scripts/check-company-scope.mjs",
    "check:secrets": "node scripts/check-repository-privacy.mjs --secrets",
    "start": "bash scripts/start-dev.sh",
    "dev": "node scripts/start-office-dev.mjs && concurrently --kill-others-on-fail -n api,web,worker -c cyan,magenta,yellow \"pnpm dev:api\" \"pnpm dev:frontend\" \"pnpm dev:worker\"",
    "dev:api": "pnpm --filter @runly/api dev",
    "dev:frontend": "pnpm --filter @runly/desktop dev:web",
    "dev:web": "pnpm --filter @runly/desktop dev:web",
    "native:android": "node apps/desktop/scripts/native-host.mjs android",
    "native:ios": "node apps/desktop/scripts/native-host.mjs ios",
    "dev:worker": "pnpm --filter @runly/worker dev",
    "dev:tauri": "node scripts/start-office-dev.mjs && concurrently --kill-others-on-fail -n api,tauri,worker -c cyan,magenta,yellow \"pnpm dev:api\" \"pnpm --filter @runly/desktop dev\" \"pnpm dev:worker\"",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:packages": "pnpm -r lint",
    "docker:build": "node infra/docker/build-push.mjs --build",
    "docker:push": "node infra/docker/build-push.mjs --push",
    "docker:release": "node infra/docker/build-push.mjs",
    "docker:release:web": "node infra/docker/build-push.mjs --web",
    "docker:release:api": "node infra/docker/build-push.mjs --api",
    "docker:release:worker": "node infra/docker/build-push.mjs --worker",
    "db:migrate": "prisma migrate deploy && prisma generate",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio --port 5555 --browser none",
    "db:reset": "prisma migrate reset --force && node prisma/seed.js",
    "db:fresh": "prisma migrate deploy && prisma generate && node prisma/seed.js",
    "setup": "pnpm install && pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "icons:generate": "node scripts/gen-icons.mjs",
    "brand:build": "node scripts/build-brand-assets.mjs",
    "brand:native": "node scripts/build-native-brand-assets.mjs",
    "rbac:verify-catalog": "node scripts/verify-permission-catalog.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio --port 5555 --browser none",
    "modules:seed": "node scripts/seed-core-modules.js",
    "check:uuid-policy": "node scripts/enforce-uuid-policy.mjs",
    "module:checksums": "node scripts/check-module-manifest-migrations.mjs",
    "module:checksums:fleet": "node scripts/check-module-manifest-migrations.mjs modules/official/runly.fleet",
    "module:checksums:write": "node scripts/check-module-manifest-migrations.mjs modules/official/runly.fleet --write",
    "db:advisor-equivalent": "node scripts/check-supabase-advisor-equivalent.mjs",
    "test:isolation": "node --test apps/api/src/services/__tests__/user-isolation.integration.test.js",
    "test:isolation:fresh": "node scripts/verify-user-isolation.mjs"
  },
  "dependencies": {
    "@atlas/core": "workspace:@runly/core@*",
    "@atlas/module-engine": "workspace:@runly/module-engine@*",
    "@atlas/offline": "workspace:@runly/offline@*",
    "@atlas/sdk": "workspace:@runly/sdk@*",
    "@atlas/ui": "workspace:@runly/ui@*",
    "@atlas/validators": "workspace:@runly/validators@*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@runly/core": "workspace:*",
    "@runly/module-engine": "workspace:*",
    "@runly/offline": "workspace:*",
    "@runly/sdk": "workspace:*",
    "@runly/ui": "workspace:*",
    "@runly/validators": "workspace:*",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "hono": "^4.13.5",
    "pdfkit": "^0.18.0",
    "pg": "^8.13.3",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "concurrently": "latest",
    "eslint": "^9"
  },
  "pnpm": {
    "overrides": {
      "@prisma/client": "^7.8.0",
      "prisma": "^7.8.0",
      "ws": "^8.21.0",
      "dompurify": "^3.4.14",
      "tmp": "^0.2.6",
      "js-yaml": "^4.3.1",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "nanoid": "^5.1.16"
    }
  }
}
