# Runly variables take precedence; equivalent ATLAS_* / VITE_ATLAS_* inputs remain supported.
# Runly ERP installer - local Supabase mode
# Copy this file to .env.local.
#
# Recommended: run setup-local.ps1 to auto-generate .env.local.
# It starts Supabase via npx and writes all values automatically.

NODE_ENV=production
RUNLY_API_PORT=4010
# Native push preparation; keep disabled until the FCM runtime is deployed.
RUNLY_FCM_ENABLED=false
FIREBASE_PROJECT_ID=
# Container path, mounted read-only from the installer .secrets/firebase directory.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase/service-account.json
RUNLY_TIME_ZONE=America/Mexico_City
TZ=America/Mexico_City

# Optional image overrides for local runtime.
# Defaults in docker-compose.yml:
# - raulbellosom/runlyerp:api-latest
# - raulbellosom/runlyerp:worker-latest
# - raulbellosom/runlyerp:web-latest
# RUNLY_API_LOCAL_IMAGE=raulbellosom/runlyerp:api-latest
# RUNLY_WORKER_LOCAL_IMAGE=raulbellosom/runlyerp:worker-latest
# RUNLY_WEB_LOCAL_IMAGE=raulbellosom/runlyerp:web-latest

# Local Supabase exposed by CLI on host machine.
# host.docker.internal is injected via extra_hosts in compose.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=<LOCAL_SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<LOCAL_SUPABASE_SERVICE_ROLE_KEY>
# Source:
# - Run `supabase start`
# - Then read values from `supabase status -o env`
SUPABASE_JWT_SECRET=<LOCAL_SUPABASE_JWT_SECRET>

# ── Instance identity and isolation (optional overrides) ─────────────────────
# setup-local.mjs auto-generates RUNLY_INSTANCE_ID and persists it here on
# first run; leave it unset and let the installer manage it. It derives the
# Docker Compose project name and container name prefix from the instance id,
# so a second Runly instance on this same host (a separate copy of this
# installer directory) never collides with this one's containers, network,
# volumes, or local Supabase project. Set these explicitly only to
# adopt/migrate an existing installation onto a chosen identity.
# RUNLY_INSTANCE_ID=
# RUNLY_COMPOSE_PROJECT_NAME=
# RUNLY_CONTAINER_PREFIX=
#
# Published host ports — override any of these (and re-run the installer) to
# avoid a conflict with another service already using the default port on
# this host. RUNLY_PUBLIC_BIND_ADDR restricts the API/web ports to a single
# interface (e.g. 127.0.0.1 when a reverse proxy sits in front); it stays
# 0.0.0.0 by default to match current behavior.
# RUNLY_API_HOST_PORT=4010
# RUNLY_WEB_HOST_PORT=5173
# RUNLY_COLLABORA_HOST_PORT=9980
# RUNLY_PUBLIC_BIND_ADDR=0.0.0.0
# LIVEKIT_HTTP_HOST_PORT=7880
# LIVEKIT_RTC_TCP_PORT=7881
# LIVEKIT_RTC_UDP_PORT=7882
# LIVEKIT_REDIS_PORT=6380
# LIVEKIT_TLS_HTTP_PORT=80
# LIVEKIT_TLS_HTTPS_PORT=443

# Runly API secret.
# In Runly today, use the same value as SUPABASE_JWT_SECRET unless you
# intentionally separate both token systems.
JWT_SECRET=<YOUR_ATLAS_API_JWT_SECRET>

# Local Postgres from Supabase CLI
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres

# Frontend public vars for local mode
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=<LOCAL_SUPABASE_ANON_KEY>
VITE_RUNLY_API_URL=http://localhost:4010

# ── Public deployment URLs ────────────────────────────────────────────────────
# For VPS + Nginx deployments, set these so the browser can reach the public API.
# CORS_ORIGIN: public URL of the Runly web app (frontend).
# RUNLY_API_URL: public URL of the Runly API. Pass as env var when running setup:
#   RUNLY_API_URL=https://api.yourdomain.com node setup-local.mjs
CORS_ORIGIN=http://localhost:5173

# ── Google Calendar integration (optional) ───────────────────────────────────
# Register OAuth credentials at: https://console.cloud.google.com → APIs & Services → Credentials
# Leave placeholders to disable Google Calendar sync.
# setup-local.mjs auto-generates GOOGLE_OAUTH_ENCRYPTION_KEY on first run and
# preserves all four values across subsequent re-runs (Supabase refresh does not wipe them).
GOOGLE_OAUTH_CLIENT_ID=<YOUR_GOOGLE_OAUTH_CLIENT_ID>
GOOGLE_OAUTH_CLIENT_SECRET=<YOUR_GOOGLE_OAUTH_CLIENT_SECRET>
GOOGLE_OAUTH_REDIRECT_URI=https://your-atlas-domain.com/app/google/calendar/callback
# Generate manually: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Or let setup-local.mjs generate it automatically.
GOOGLE_OAUTH_ENCRYPTION_KEY=<AUTO_GENERATED_BY_SETUP>

# ── atlas.pfm — lectura de tickets con IA (opcional) ─────────────────────────
# Sin GROQ_API_KEY el modulo funciona igual y la subida de tickets responde 503
# (la UI cae a captura manual). Consigue una clave gratis en https://console.groq.com
PFM_VISION_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com
PFM_VISION_MODEL=qwen/qwen3.6-27b
PFM_VISION_TIMEOUT_MS=20000

# ── Atlas Calls / LiveKit ──────────────────────────────────────────────────
# embedded is the default. Domain is optional for localhost development.
LIVEKIT_MODE=embedded
LIVEKIT_DOMAIN=
LIVEKIT_TLS_MODE=managed
LIVEKIT_URL=
LIVEKIT_INTERNAL_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
