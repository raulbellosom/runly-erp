# Runly variables take precedence; equivalent ATLAS_* / VITE_ATLAS_* inputs remain supported.
# Runly ERP installer - local Supabase mode
# Copy this file to .env.local.
#
# Recommended: run setup-local.ps1 to auto-generate .env.local.
# It starts Supabase via npx and writes all values automatically.

NODE_ENV=production
RUNLY_API_PORT=4010
# Native push preparation; keep disabled until the FCM runtime is deployed.
RUNLY_FCM_ENABLED=false
FIREBASE_PROJECT_ID=
# Container path, mounted read-only from the installer .secrets/firebase directory.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase/service-account.json
RUNLY_TIME_ZONE=America/Mexico_City
TZ=America/Mexico_City

# Optional image overrides for local runtime.
# Defaults in docker-compose.yml:
# - raulbellosom/runlyerp:api-latest
# - raulbellosom/runlyerp:worker-latest
# - raulbellosom/runlyerp:web-latest
# RUNLY_API_LOCAL_IMAGE=raulbellosom/runlyerp:api-latest
# RUNLY_WORKER_LOCAL_IMAGE=raulbellosom/runlyerp:worker-latest
# RUNLY_WEB_LOCAL_IMAGE=raulbellosom/runlyerp:web-latest

# ── Supabase (installer-managed) ──────────────────────────────────────────────
# RUNLY_SUPABASE_MODE=selfhosted (the default for new installs) runs a real,
# production-grade self-hosted Supabase via
# infra/installer/supabase/docker-compose.supabase.yml — Postgres, Auth,
# REST, Realtime, and Storage, none of them published to the internet except
# the Kong gateway (see RUNLY_SUPABASE_KONG_HOST_PORT below). All the
# SUPABASE_*/RUNLY_SUPABASE_* values in this section are then generated once
# by setup-local.mjs and persisted here — leave them unset on first run.
#
# RUNLY_SUPABASE_MODE=cli-dev keeps the OLD Supabase-CLI-based flow
# (`supabase start`) for local development convenience only. It binds
# Postgres/Studio to the host with no auth and is NOT for production — pass
# --dev-supabase-cli to setup-local.mjs on a fresh install to opt into it.
# RUNLY_SUPABASE_MODE=selfhosted
SUPABASE_URL=http://supabase-kong:8000
SUPABASE_ANON_KEY=<AUTO_GENERATED_BY_SETUP>
SUPABASE_SERVICE_ROLE_KEY=<AUTO_GENERATED_BY_SETUP>
SUPABASE_JWT_SECRET=<AUTO_GENERATED_BY_SETUP>
SUPABASE_POSTGRES_PASSWORD=<AUTO_GENERATED_BY_SETUP>
RUNLY_SUPABASE_SECRET_KEY_BASE=<AUTO_GENERATED_BY_SETUP>
RUNLY_SUPABASE_REALTIME_DB_ENC_KEY=<AUTO_GENERATED_BY_SETUP>
RUNLY_SUPABASE_META_CRYPTO_KEY=<AUTO_GENERATED_BY_SETUP>
# Kong (Supabase API gateway) — the only Supabase-side port the browser
# reaches directly (Auth/Realtime/Storage). Postgres and Studio are never
# published beyond 127.0.0.1; see infra/installer/supabase/docker-compose.supabase.yml.
# RUNLY_SUPABASE_KONG_HOST_PORT=8000
# RUNLY_SUPABASE_STUDIO_HOST_PORT=54323
# Optional SMTP for account confirmation / password-reset emails. Without
# it, account confirmation is auto-approved (no email is ever sent).
# RUNLY_SUPABASE_SMTP_HOST=
# RUNLY_SUPABASE_SMTP_PORT=587
# RUNLY_SUPABASE_SMTP_USER=
# RUNLY_SUPABASE_SMTP_PASS=
# RUNLY_SUPABASE_SMTP_ADMIN_EMAIL=
# RUNLY_SUPABASE_SMTP_SENDER_NAME=Runly

# ── Instance identity and isolation (optional overrides) ─────────────────────
# setup-local.mjs auto-generates RUNLY_INSTANCE_ID and persists it here on
# first run; leave it unset and let the installer manage it. It derives the
# Docker Compose project name and container name prefix from the instance id,
# so a second Runly instance on this same host (a separate copy of this
# installer directory) never collides with this one's containers, network,
# volumes, or local Supabase project. Set these explicitly only to
# adopt/migrate an existing installation onto a chosen identity.
# RUNLY_INSTANCE_ID=
# RUNLY_COMPOSE_PROJECT_NAME=
# RUNLY_CONTAINER_PREFIX=
#
# Published host ports — override any of these (and re-run the installer) to
# avoid a conflict with another service already using the default port on
# this host. RUNLY_PUBLIC_BIND_ADDR restricts the API/web/Kong ports to a
# single interface (e.g. 127.0.0.1 when a reverse proxy sits in front); it
# stays 0.0.0.0 by default to match current behavior. Postgres and Supabase
# Studio are never affected by RUNLY_PUBLIC_BIND_ADDR — they are always
# loopback-only (Studio) or unpublished entirely (Postgres) in selfhosted mode.
# RUNLY_API_HOST_PORT=4010
# RUNLY_WEB_HOST_PORT=5173
# RUNLY_COLLABORA_HOST_PORT=9980
# RUNLY_PUBLIC_BIND_ADDR=0.0.0.0
# LIVEKIT_HTTP_HOST_PORT=7880
# LIVEKIT_RTC_TCP_PORT=7881
# LIVEKIT_RTC_UDP_PORT=7882
# LIVEKIT_REDIS_PORT=6380
# LIVEKIT_TLS_HTTP_PORT=80
# LIVEKIT_TLS_HTTPS_PORT=443

# Runly API secret.
# In Runly today, use the same value as SUPABASE_JWT_SECRET unless you
# intentionally separate both token systems.
JWT_SECRET=<AUTO_GENERATED_BY_SETUP>

# Postgres, reached over the Docker Compose network directly (no pooler —
# see infra/installer/supabase/VENDORED_FROM.md for why Supavisor was dropped).
DATABASE_URL=postgresql://postgres:<SUPABASE_POSTGRES_PASSWORD>@supabase-db:5432/postgres
DIRECT_URL=postgresql://postgres:<SUPABASE_POSTGRES_PASSWORD>@supabase-db:5432/postgres

# Frontend public vars for local mode — defaults to the Kong gateway port above.
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=<AUTO_GENERATED_BY_SETUP>
VITE_RUNLY_API_URL=http://localhost:4010

# ── Public deployment URLs ────────────────────────────────────────────────────
# For VPS + Nginx deployments, set these so the browser can reach the public
# API and Supabase gateway (point your host Nginx's server blocks at
# RUNLY_API_HOST_PORT / RUNLY_SUPABASE_KONG_HOST_PORT for the two domains).
# CORS_ORIGIN: public URL of the Runly web app (frontend).
# RUNLY_API_URL: public URL of the Runly API.
# RUNLY_SUPABASE_PUBLIC_URL: public URL of the Supabase gateway. Pass as env
# vars when running setup:
#   RUNLY_API_URL=https://api.yourdomain.com RUNLY_SUPABASE_PUBLIC_URL=https://supabase.yourdomain.com node setup-local.mjs
CORS_ORIGIN=http://localhost:5173

# ── Google Calendar integration (optional) ───────────────────────────────────
# Register OAuth credentials at: https://console.cloud.google.com → APIs & Services → Credentials
# Leave placeholders to disable Google Calendar sync.
# setup-local.mjs auto-generates GOOGLE_OAUTH_ENCRYPTION_KEY on first run and
# preserves all four values across subsequent re-runs (Supabase refresh does not wipe them).
GOOGLE_OAUTH_CLIENT_ID=<YOUR_GOOGLE_OAUTH_CLIENT_ID>
GOOGLE_OAUTH_CLIENT_SECRET=<YOUR_GOOGLE_OAUTH_CLIENT_SECRET>
GOOGLE_OAUTH_REDIRECT_URI=https://your-atlas-domain.com/app/google/calendar/callback
# Generate manually: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Or let setup-local.mjs generate it automatically.
GOOGLE_OAUTH_ENCRYPTION_KEY=<AUTO_GENERATED_BY_SETUP>

# ── atlas.pfm — lectura de tickets con IA (opcional) ─────────────────────────
# Sin GROQ_API_KEY el modulo funciona igual y la subida de tickets responde 503
# (la UI cae a captura manual). Consigue una clave gratis en https://console.groq.com
PFM_VISION_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com
PFM_VISION_MODEL=qwen/qwen3.6-27b
PFM_VISION_TIMEOUT_MS=20000

# ── Reportar bug (opcional) ───────────────────────────────────────────────────
# Destino del boton "Reportar bug". Se envia por el SMTP de plataforma
# configurado en Ajustes -> SMTP (o el de la empresa activa si el de
# plataforma no esta configurado). Vacio deshabilita el boton en esta instancia.
RUNLY_SUPPORT_EMAIL=

# ── Atlas Calls / LiveKit ──────────────────────────────────────────────────
# embedded is the default. Domain is optional for localhost development.
LIVEKIT_MODE=embedded
LIVEKIT_DOMAIN=
LIVEKIT_TLS_MODE=managed
LIVEKIT_URL=
LIVEKIT_INTERNAL_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Runly Transcription (faster-whisper, optional) ───────────────────────────
# local: instala y ejecuta faster-whisper en un contenedor propio en esta VPS.
# disabled (default): no se instala ni activa ningun contenedor ni UI de transcripcion.
TRANSCRIPTION_MODE=disabled
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
# Fijar explicitamente segun el limite real de CPU del contenedor (ver
# TRANSCRIBER_CPU_LIMIT abajo) — no dejar en automatico, ver
# docs/TRANSCRIPTION_IMPLEMENTATION_PLAN.md Etapa 2.
WHISPER_CPU_THREADS=2
# Autogenerados por setup-local.mjs — no editar a mano.
TRANSCRIBER_DB_PASSWORD=
TRANSCRIBER_DATABASE_URL=
# Limites del contenedor runly-transcriber (docker-compose.yml).
# TRANSCRIBER_CPU_LIMIT=1.5
# TRANSCRIBER_MEMORY_LIMIT=3g

# ── MirAI text-to-speech (Piper, optional) ───────────────────────────────────
# local: instala y ejecuta runly-tts en un contenedor propio en esta VPS.
# disabled (default): no se instala ni activa ningun contenedor ni boton en la UI.
MIRAI_TTS_MODE=disabled
TTS_CPU_THREADS=2
# Derivada automaticamente por setup-local.mjs — no editar a mano.
MIRAI_TTS_URL=
# Limites del contenedor runly-tts (docker-compose.yml). Default: 1 CPU,
# 1024m RAM. Sube TTS_MEMORY_LIMIT si "leer en voz alta" da 502 en respuestas
# largas (el contenedor se queda sin RAM y el kernel lo mata a medio proceso).
# TTS_CPU_LIMIT=1
# TTS_MEMORY_LIMIT=1024m
