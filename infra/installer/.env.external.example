# Runly variables take precedence; equivalent ATLAS_* / VITE_ATLAS_* inputs remain supported.
# Runly ERP installer - external Supabase mode
# Copy this file to .env.external and fill placeholders.

NODE_ENV=production
RUNLY_API_PORT=4010
# Native push preparation; keep disabled until the FCM runtime is deployed.
RUNLY_FCM_ENABLED=false
FIREBASE_PROJECT_ID=
# Container path. Upload the server JSON to .secrets/firebase/service-account.json
# beside this installer. google-services.json belongs on the Android build machine.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase/service-account.json
RUNLY_TIME_ZONE=America/Mexico_City
TZ=America/Mexico_City

# External Supabase endpoint and keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>
# Source:
# - Supabase Cloud: Project Settings -> API -> JWT secret
# - Supabase self-hosted: value named JWT_SECRET in Supabase .env
SUPABASE_JWT_SECRET=<YOUR_SUPABASE_JWT_SECRET>

# ── Instance identity and isolation (optional overrides) ─────────────────────
# setup-external.mjs auto-generates RUNLY_INSTANCE_ID and persists it here on
# first run; leave it unset and let the installer manage it. It derives the
# Docker Compose project name and container name prefix from the instance id,
# so a second Runly instance on this same host (a separate copy of this
# installer directory) never collides with this one's containers, network, or
# volumes. Set these explicitly only to adopt/migrate an existing installation
# onto a chosen identity.
# RUNLY_INSTANCE_ID=
# RUNLY_COMPOSE_PROJECT_NAME=
# RUNLY_CONTAINER_PREFIX=
#
# Published host ports — override any of these (and re-run the installer) to
# avoid a conflict with another service already using the default port on
# this host. RUNLY_PUBLIC_BIND_ADDR restricts the API/web ports to a single
# interface (e.g. 127.0.0.1 when a reverse proxy sits in front); it stays
# 0.0.0.0 by default to match current behavior.
# RUNLY_API_HOST_PORT=4010
# RUNLY_WEB_HOST_PORT=5173
# RUNLY_COLLABORA_HOST_PORT=9980
# RUNLY_PUBLIC_BIND_ADDR=0.0.0.0
# LIVEKIT_HTTP_HOST_PORT=7880
# LIVEKIT_RTC_TCP_PORT=7881
# LIVEKIT_RTC_UDP_PORT=7882
# LIVEKIT_REDIS_PORT=6380
# LIVEKIT_TLS_HTTP_PORT=80
# LIVEKIT_TLS_HTTPS_PORT=443

# Runly API secret.
# In Runly today, use the same value as SUPABASE_JWT_SECRET unless you
# intentionally separate both token systems.
JWT_SECRET=<YOUR_ATLAS_API_JWT_SECRET>

# Database connection used by Prisma
DATABASE_URL=postgresql://postgres:<PASSWORD>@<HOST>:5432/postgres
DIRECT_URL=postgresql://postgres:<PASSWORD>@<HOST>:5432/postgres

# Frontend public vars (if your web image was built for runtime placeholders)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>
VITE_RUNLY_API_URL=http://localhost:4010

# ── Public deployment URLs ────────────────────────────────────────────────────
# For VPS + Nginx deployments, set these to your public domains so the browser
# can reach both the API and Supabase from the internet.
# CORS_ORIGIN: public URL of the Runly web app (frontend).
# RUNLY_API_URL: public URL of the Runly API, used by the web container at runtime.
# RUNLY_APP_URL: full HTTPS root URL of this Runly ERP instance (e.g. https://atlas.yourdomain.com).
#   Used to inject the storefront SDK baseUrl into website static builds.
#   Must be HTTPS in production — omitting it causes Mixed Content errors on HTTPS sites.
CORS_ORIGIN=http://localhost:5173
RUNLY_API_URL=http://localhost:4010
RUNLY_APP_URL=https://atlas.yourdomain.com

# ── Custom module ZIP upload ─────────────────────────────────────────────────
# Container-side path where custom-modules/ is mounted (matches docker-compose volume).
# Required for POST /modules/:key/upload and DELETE /modules/:key/purge.
RUNLY_MODULES_DIR=/app/modules/custom

# ── Google Calendar integration (optional) ───────────────────────────────────
# Register OAuth credentials at: https://console.cloud.google.com → APIs & Services → Credentials
# Leave placeholders to disable Google Calendar sync.
GOOGLE_OAUTH_CLIENT_ID=<YOUR_GOOGLE_OAUTH_CLIENT_ID>
GOOGLE_OAUTH_CLIENT_SECRET=<YOUR_GOOGLE_OAUTH_CLIENT_SECRET>
GOOGLE_OAUTH_REDIRECT_URI=https://your-atlas-domain.com/app/google/calendar/callback
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_OAUTH_ENCRYPTION_KEY=<YOUR_GOOGLE_OAUTH_ENCRYPTION_KEY>

# ── atlas.pfm — lectura de tickets con IA (opcional) ─────────────────────────
# Sin GROQ_API_KEY el modulo funciona igual y la subida de tickets responde 503
# (la UI cae a captura manual). Consigue una clave gratis en https://console.groq.com
PFM_VISION_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com
PFM_VISION_MODEL=qwen/qwen3.6-27b
PFM_VISION_TIMEOUT_MS=20000

# ── Atlas Calls / LiveKit ──────────────────────────────────────────────────
# embedded is the default and installs LiveKit + Redis. Set LIVEKIT_DOMAIN to a
# DNS hostname that already points to this server. managed starts Caddy and
# provisions trusted TLS/WSS automatically; external writes a reverse-proxy
# example and expects TLS termination to be configured outside Runly.
LIVEKIT_MODE=embedded
LIVEKIT_DOMAIN=
LIVEKIT_TLS_MODE=managed
LIVEKIT_URL=
LIVEKIT_INTERNAL_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional Office profile (independent of LiveKit).
RUNLY_OFFICE_ENABLED=false
COLLABORA_INTERNAL_URL=http://collabora:9980
COLLABORA_PUBLIC_URL=https://office.example.com
RUNLY_WOPI_URL=http://api:4010
RUNLY_OFFICE_HOST_ORIGIN=https://erp.example.com
RUNLY_OFFICE_ADDITIONAL_ORIGINS=http://tauri.localhost,https://tauri.localhost,tauri://localhost
# Installer generates a stable secret when enabled; never expose it in VITE_*.
RUNLY_WOPI_SECRET=
RUNLY_WOPI_TOKEN_SECONDS=28800
