# RUNLY_* only — there is no ATLAS_* fallback for these variables.
# Runly ERP — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
#
# ─── IMPORTANT: Self-hosted Supabase ─────────────────────────────────────────
# This project connects to a dedicated self-hosted Supabase instance.
# It is NOT Supabase Cloud. The "Settings → Database" screen in Studio
# may not be available or may differ from Cloud docs.
#
# Get keys and the Postgres password from your own deployment's private config.
# Example path (replace it): /path/to/supabase/docker/.env
# Copy: ANON_KEY → SUPABASE_ANON_KEY
#       SERVICE_ROLE_KEY → SUPABASE_SERVICE_ROLE_KEY
#       JWT_SECRET → SUPABASE_JWT_SECRET
#       POSTGRES_PASSWORD → used in DATABASE_URL and DIRECT_URL below
#
# Domains and paths in this template are examples, not deployed services.
# Use your private network or an SSH tunnel for the database connection.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
RUNLY_APP_NAME="Runly ERP"
RUNLY_API_PORT=4010
# Root URL of this Runly ERP instance (no trailing slash).
# Used for: email notification links, OAuth redirects, and injecting into
# storefront dist files as window.RUNLY_CONFIG.apiUrl (window.ATLAS_CONFIG
# alias also set) for the storefront SDK.
# Dev: http://localhost:5173 (Vite) — dist serving falls back to request host.
# Production: https://atlas.example.com (or your Runly domain, without /app/).
RUNLY_APP_URL=http://localhost:5173
RUNLY_TIME_ZONE=America/Mexico_City
TZ=America/Mexico_City

# ─── Supabase (define once) ──────────────────────────────────────────────────
# Source: /path/to/supabase/docker/.env on the VPS
SUPABASE_URL=https://supabase.example.com
SUPABASE_STUDIO_URL=https://studio.supabase.example.com
SUPABASE_ANON_KEY=             # ANON_KEY from VPS .env — public, safe for frontend
SUPABASE_SERVICE_ROLE_KEY=     # SERVICE_ROLE_KEY from VPS .env — SECRET, API/worker only
SUPABASE_JWT_SECRET=           # JWT_SECRET from VPS .env — used by Supabase to sign tokens

# LiveKit Egress → Supabase Storage S3-compatible upload (call recordings).
# Get these from the self-hosted Supabase Storage container's own config on
# the VPS (/path/to/supabase/docker/.env) — NOT the same as
# SUPABASE_SERVICE_ROLE_KEY. See docs/superpowers/specs/2026-09-13-atlas-calls-recording-design.md §24 risk 2.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=us-east-1

# ─── Prisma / PostgreSQL ─────────────────────────────────────────────────────
# Example: local SSH forward to your direct Postgres endpoint (not a pooler).
# Replace the password and adapt host/port to your own deployment.
# Keep the tunnel open while API/worker or database commands use these URLs.
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:<POSTGRES_PASSWORD>@127.0.0.1:54322/postgres

# ─── Runly API ───────────────────────────────────────────────────────────────
JWT_SECRET=                    # Runly API own secret — generate a random 64-char string
CORS_ORIGIN=http://localhost:5173,tauri://localhost

# ─── Identity-level SMTP (password reset, cross-company mail) ────────────────
# Ajustes -> SMTP configures a SPECIFIC COMPANY's outgoing mail (invitations,
# call invites, chat, etc. for that company) and always wins for that company.
# It has nothing to do with these vars.
# These vars are for mail that isn't any one company's business — password
# reset above all: the recipient may belong to several companies, or none.
# When set, they are used outright for that mail, before the database is even
# checked, so a stale/undecryptable row left over from an old setup can never
# block them. Point them at YOUR OWN mail provider — self-hosted, per
# instance. Runly does not relay this mail for you. Leave empty and this mail
# simply won't send until you set them (there is no UI for this slot).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Runly ERP
SMTP_FROM_EMAIL=
SMTP_TLS=false

# Destination address for the "Reportar bug" button (ApiErrorScreen /
# ErrorState). Sent via the platform SMTP above (or, if that isn't
# configured, via the active company's own SMTP relay). Leave empty to hide
# bug reporting on this instance.
RUNLY_SUPPORT_EMAIL=

# ─── Custom module ZIP upload ─────────────────────────────────────────────────
# Absolute path to the directory where custom module ZIPs are extracted.
# In Docker deployments this is the container-side path of the volume-mounted
# custom-modules/ directory (e.g. /app/modules/custom).
# Leave empty to disable POST /modules/:key/upload and DELETE /modules/:key/purge (returns 503).
# Mac/Linux dev: set to the absolute path of modules/custom/ in this repo.
# Windows dev:   set to the absolute Windows path (e.g. C:\path\to\modules\custom).
RUNLY_MODULES_DIR=

# Firebase / Android native push (configuration preparation; integration pending)
# See docs/mobile/FIREBASE_SETUP.md. Android build configuration is supported;
# the server sender, token registration and native receiver are still pending.
# Keep disabled until the server sender and Android receiver are implemented.
RUNLY_FCM_ENABLED=false
# Firebase console > Project settings > General > Project ID (not project number).
FIREBASE_PROJECT_ID=
# PRIVATE service-account JSON: API/delivery worker only, never VITE_ or APK.
# Use an absolute path. Example local: D:/path/to/atlaserp-v2/.secrets/firebase/service-account.json
# Docker: mount the file read-only and use its CONTAINER path, e.g.
# /run/secrets/firebase/service-account.json (not the Windows host path).
GOOGLE_APPLICATION_CREDENTIALS=
# Android build configuration JSON downloaded for com.racoondevs.runlyerp.
# native-host reads this build input from process.env, falling back to root .env.
# It validates the package/project and copies only this JSON into Android.
# Example: D:/path/to/atlaserp-v2/.secrets/firebase/google-services.json
RUNLY_ANDROID_GOOGLE_SERVICES_JSON=
# Web/PWA keep their existing VAPID Web Push configuration.

# Runly Calls / LiveKit
# embedded is the default. For host-based development, run LiveKit on port 7880
# and keep the browser URL separate from the API-to-LiveKit HTTP URL.
LIVEKIT_MODE=embedded
LIVEKIT_DOMAIN=
LIVEKIT_TLS_MODE=managed
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_INTERNAL_URL=http://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Runly Transcription (faster-whisper, optional)
# Only relevant if you run apps/transcriber locally against this same database —
# the Node API itself needs none of these to boot; requesting a transcription
# just creates a PENDING row that stays PENDING until a transcriber container
# claims it. TRANSCRIBER_DATABASE_URL/TRANSCRIBER_DB_PASSWORD are normally
# auto-generated by the installer for a real deployment (infra/installer/), not
# hand-set here.
TRANSCRIPTION_MODE=disabled
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=2
TRANSCRIBER_DB_PASSWORD=
TRANSCRIBER_DATABASE_URL=

# MirAI text-to-speech (Piper, optional)
# Only relevant if you run apps/tts locally (POST /synthesize) and point
# MIRAI_TTS_URL at it. Without it, GET /chat/mirai/status reports tts:false
# and the desktop app simply doesn't show the "leer en voz alta" button.
# Stateless — no database role, no password to generate.
MIRAI_TTS_MODE=disabled
TTS_CPU_THREADS=2
MIRAI_TTS_URL=

# ─── Vite aliases (VITE_ prefix required by Vite for frontend access) ────────
# Only SUPABASE_URL and SUPABASE_ANON_KEY may be aliased for the frontend.
# NEVER add VITE_ aliases for SERVICE_ROLE_KEY, SUPABASE_JWT_SECRET, JWT_SECRET, or DATABASE_URL.
# WARNING: Docker Compose does NOT expand ${VAR} syntax in .env files.
#          Set explicit values here — do NOT use ${SUPABASE_URL} style references.
VITE_SUPABASE_URL=https://supabase.example.com
VITE_SUPABASE_ANON_KEY=        # Same value as SUPABASE_ANON_KEY above
VITE_RUNLY_API_URL=http://localhost:4010
VITE_BASE_PATH=/app/           # Base path for production routing (e.g. /app/); dev defaults to empty

# Google Calendar OAuth
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/app/google/calendar/callback
# Generate once per instance. Do not rotate without forcing users to reconnect Google.
# PowerShell:
# [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# Node:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_OAUTH_ENCRYPTION_KEY=replace-with-32-byte-base64

# runly.pfm — receipt OCR (vision LLM). Optional: without GROQ_API_KEY the
# module still runs and receipt upload returns 503 (UI falls back to manual entry).
PFM_VISION_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com
PFM_VISION_MODEL=qwen/qwen3.8-27b
PFM_VISION_TIMEOUT_MS=20000

# Inventario reutiliza Groq, el modelo de visión y MirAI. Este secreto
# opcional firma reconocimientos y cifra el contexto temporal (fallback: GROQ_API_KEY).
# Mantén el mismo valor en todas las réplicas de la API; nunca lo envíes al navegador.
INVENTORY_AI_SIGNING_SECRET=
# Optional: override the model the runly.pfm assistant sidebar uses (default: openai/gpt-oss-120b).
# Without GROQ_API_KEY the assistant sidebar is simply disabled.
PFM_ASSISTANT_MODEL=
# Optional: override the model MirAI (runly.chat AI assistant) uses for
# tool-calling (default: openai/gpt-oss-120b). Image description reuses the
# vision model (PFM_VISION_MODEL). Without GROQ_API_KEY the MirAI conversation
# still lists but its composer shows "no configurado".
CHAT_MIRAI_MODEL=
# MirAI: salida a internet para preguntas de datos en vivo (el dolar hoy,
# noticias, etc.). Con TAVILY_API_KEY usa Tavily (plan gratis ~1000/mes en
# tavily.com); sin ella el modo "live" responde "no puedo consultar internet".
# CHAT_MIRAI_WEB=false lo desactiva del todo.
TAVILY_API_KEY=
CHAT_MIRAI_WEB=true
# Alternativa a Tavily: un modelo compound de Groq (requiere plan de pago Groq).
# Solo se usa si NO hay TAVILY_API_KEY y esta variable esta puesta.
CHAT_MIRAI_WEB_MODEL=
# Modelo para la llamada corta de clasificacion de intencion (chat/general/live).
# Default openai/gpt-oss-120b.
CHAT_MIRAI_ROUTER_MODEL=
# Optional Collabora CODE; see docs/deployment/office-collabora.md.
RUNLY_OFFICE_ENABLED=false
COLLABORA_INTERNAL_URL=http://127.0.0.1:9980
COLLABORA_PUBLIC_URL=http://localhost:9980
RUNLY_WOPI_URL=http://host.docker.internal:4010
RUNLY_OFFICE_HOST_ORIGIN=http://localhost:5173
RUNLY_OFFICE_ADDITIONAL_ORIGINS=http://tauri.localhost,https://tauri.localhost,tauri://localhost
# Generate in your terminal: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Paste the output below. Keep server-side and preserve the key across deployments.
RUNLY_WOPI_SECRET=
RUNLY_WOPI_TOKEN_SECONDS=28800
